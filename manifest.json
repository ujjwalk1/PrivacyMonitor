{
  "manifest_version": 2,
  "name": "Privacy & Security Monitor",
  "version": "1.1",
  "description": "Monitor password strength, security headers, data breaches, and insecure forms",
  "icons": { "48": "icon.svg", "96": "icon.svg" },

  "permissions": [
    "storage",
    "webRequest",
    "webNavigation",
    "http://*/*",
    "https://*/*"
  ],

  "background": {
    "scripts": ["analysis-records.js", "analysis-background.js", "popup-state.js", "breach-service.js", "background.js"],
    "persistent": true
  },

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["settings.js", "content-script.js"]
    }
  ],

  "browser_action": {
    "default_icon": { "16": "icon.svg", "32": "icon.svg" },
    "theme_icons": [
      { "light": "icon-light.svg", "dark": "icon-dark.svg", "size": 16 },
      { "light": "icon-light.svg", "dark": "icon-dark.svg", "size": 32 }
    ],
    "default_popup": "popup.html",
    "default_title": "Privacy Monitor"
  },

  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "privacy-monitor@example.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": ["browsingActivity"]
      }
    }
  }
}
